# 复制此文件为 .env 后按需修改（.env 不会被提交到 git）

# ---------- 站点 ----------
SITE_URL=https://yjgnet.cn

# ---------- LLM 配置 ----------
# 留空则 AI 助手使用内置预设知识库回复；
# 填入 API Key 后自动切换为真实模型（任意 OpenAI 兼容接口均可）
# DeepSeek:   https://api.deepseek.com/v1                    模型 deepseek-flash（V4.1 Flash）
# 通义千问:   https://dashscope.aliyuncs.com/compatible-mode/v1  模型 qwen-plus
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash

# ---------- AI 助手防滥用限制（防止 token 被恶意消耗） ----------
# 单次回复生成上限（token）
LLM_MAX_TOKENS=500
# 每 IP 每分钟最大请求次数
CHAT_RATE_LIMIT=10
# 每 IP 每日最大请求次数
CHAT_DAILY_LIMIT_PER_IP=30
# 全站每日 token 预算（粗估值）：超出后自动降级为预设知识库，不再消耗 token
CHAT_DAILY_TOKEN_BUDGET=200000

# ---------- LLM 故障转移与健康检测（断路器 + 主动探针） ----------
# 备用通道（可选）：配置后主通道故障时自动切换；留空则降级预设知识库
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
# 连续失败几次后断路器打开（打开后快速失败，跳过真实调用）
LLM_CB_FAILURE_THRESHOLD=3
# 断路后多少秒进入半开（等待健康探针试探恢复）
LLM_CB_RECOVERY_TIMEOUT=90
# 半开状态下探针连续成功几次才真正恢复
LLM_CB_SUCCESS_THRESHOLD=1
# 健康探针间隔（秒）：仅在断路器打开时发探针（正常时靠真实请求被动检测）
LLM_PROBE_INTERVAL=60

# ---------- 简历邮件技能（skills/send-resume） ----------
# 技能总开关：访客在聊天中留下邮箱后，自动把简历 PDF 发送给他
RESUME_EMAIL_ENABLED=true
# 简历文件路径（相对项目根目录）
RESUME_FILE=static/files/resume.pdf
# 每 IP 每日发送上限（防邮箱被滥用）
RESUME_DAILY_LIMIT_PER_IP=3

# ---------- 服务器监控告警（deploy/server_monitor.py 使用） ----------
# 另外：简历邮件技能（send-resume）也复用此 SMTP 账号发信
# 邮件总开关：false 或留空则不发送任何邮件
ALERT_EMAIL_ENABLED=false
# SMTP 服务器（QQ 邮箱为 smtp.qq.com 端口 465，SSL）
ALERT_SMTP_HOST=smtp.qq.com
ALERT_SMTP_PORT=465
# 发件账号与授权码（授权码在邮箱设置里生成，不是登录密码）
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
# 收件地址（留空则发给发件账号自己）
ALERT_EMAIL_TO=
# 同类告警冷却时间（小时）：防止同一问题反复轰炸邮箱
ALERT_COOLDOWN_HOURS=6
# 磁盘 / 内存使用率告警阈值（百分比）
ALERT_DISK_THRESHOLD=85
ALERT_MEM_THRESHOLD=90
